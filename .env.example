# ============================================================================
# Budapest H3 Accident Risk Platform — Vercel Environment Variables Template
# Copy these variables into Vercel -> Project Settings -> Environment Variables
# IMPORTANT: Never prefix secret keys with NEXT_PUBLIC_!
# ============================================================================

# 1. Admin Portal HTTP Basic Auth Protection (/admin and /api/admin/*)
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-to-a-strong-password

# 2. 15-Minute Cron Endpoint Protection (/api/cron/predict)
CRON_SECRET=generate-a-random-32-char-secret-token
# Set to 'false' on public production if you want ONLY the background cron / admin to trigger predictions:
CRON_ALLOW_PUBLIC_TRIGGER=true

# 3. Live Traffic & Transit Telemetry Keys (Server-Side Only)
BKK_API_KEY=your-bkk-futar-api-key
TOMTOM_API_KEY=your-tomtom-developer-api-key

# 4. Optional Supabase Persistence (Falls back to zero-config local store if omitted)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key
